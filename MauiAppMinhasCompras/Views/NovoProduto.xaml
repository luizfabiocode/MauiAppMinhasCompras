<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked"/>
    </ContentPage.ToolbarItems>

    <VerticalStackLayout Spacing="15" Padding="20">

        <Label Text="Descrição do Produto:" 
               FontAttributes="Bold"
               TextColor="Black"/>
        <Entry x:Name="txt_descriçao" 
               Placeholder="Digite a descrição..."
               BackgroundColor="#F0F0F0"/>

        <Label Text="Quantidade:" 
               FontAttributes="Bold"
               TextColor="Black"/>
        <Entry x:Name="txt_quantidade" 
               Keyboard="Numeric"
               Placeholder="Digite a quantidade..."
               BackgroundColor="#F0F0F0"/>

        <Label Text="Preço Unitário:" 
               FontAttributes="Bold"
               TextColor="Black"/>
        <Entry x:Name="txt_preco" 
               Keyboard="Numeric"
               Placeholder="Digite o preço..."
               BackgroundColor="#F0F0F0"/>

        <!-- ⭐ NOVO: Botão Salvar na tela (opcional, além do Toolbar) -->
        <Button Text="Salvar Produto"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="ToolbarItem_Clicked"
                Margin="0,20,0,0"/>

    </VerticalStackLayout>
</ContentPage>